  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7b83e422ecce814ea1718ba32792b10, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterBase: {fileID: 523242092}
  characters:
  - {fileID: 21300000, guid: 1a68fb78c3f63064aac3e4f3cb908f6d, type: 3}
  - {fileID: 21300000, guid: d9b8a725032ec13449762f04e412542d, type: 3}
  - {fileID: 21300000, guid: 12d00fd3843c6cd468e8b1f49ee63037, type: 3}
  tutorialLines1:
  - '?????: Wait where am I?'
  tut1Speaker: 03000000
  tutorialLines2:
  - 'Jerry: Ho ho ho, well heya there Wally'
  - '?????: Wally?'
  - 'Jerry: How could you forget your own name old pal'''
  - 'Wally: Where am I?'
  - "Jerry: Your right were you\u2019ve always been of course!"
  - "Wally: (Under breath) where I always\u2026 What does that even mean!? How do
    I get out of here\u2026 how do I get home??"
  - 'Jerry: Oh ho ho, if home is what you seek then all you need is to find 1 bottle
    cap and bring them to the scale by the exit door'
  - 'Wally: What kinda sick game is this??'
  tut2Speaker: 0000000003000000000000000100000000000000010000000000000001000000
  tutorialLines3:
  - 'Wally: Is this a joke?'
  - "Jerry: Nope it\u2019s a key to the puzzle; he he ho. Find 3 more and maybe you
    can escape"
  tut3Speaker: 0100000000000000
  safeRoomLines1:
  - 'Wally: The heck is that'
  - "Jerry: That\u2019s just one of the residents here, they\u2019re not too friendly
    though\u2026"
  saf1speaker: 0100000000000000
  saf1GO: 0
  safeRoomLines2:
  - 'Wally: Did you just try to kill me??'
  - 'Jerry:  Nope, but hey look where we are a safe room, as long as your in here
    your sanity will be replenished'
  - 'Wally: Sanity?'
  - 'Jerry: Yup, just keep your chill and no more spooky ghosts will come after you'
  - 'jerry: Ho, Ho; Now just find the rest!!'
  saf2speaker: 0100000000000000010000000000000000000000
  saf2GO: 0
  textSpd: 0.03
